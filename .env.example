# 환경변수 템플릿. 실제 값은 .env.local 에 채운다(커밋 금지).
# 규칙: NEXT_PUBLIC_ 접두사는 브라우저에 노출됨 → 시크릿엔 절대 사용 금지.

# ===== Supabase =====
# 로컬은 NEXT_PUBLIC_ 이름으로. Vercel 은 Production 변수가 Sensitive 강제라 NEXT_PUBLIC_ 추가가 거부되므로
# 접두사 없는 SUPABASE_URL / SUPABASE_ANON_KEY 로 넣는다(next.config.ts 가 빌드 시 NEXT_PUBLIC_ 으로 매핑).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 — RLS 우회 서비스 롤 키. 절대 NEXT_PUBLIC_ 금지.
SUPABASE_SERVICE_ROLE_KEY=

# ===== Toss Payments (스노위랜드 신규 MID) =====
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# 서버 결제 승인/취소 API 인증용 시크릿 키. 절대 NEXT_PUBLIC_ 금지.
TOSS_SECRET_KEY=

# ===== 결제 모드 =====
# fake(개발): 두 값 모두 '1' → 토스 위젯 대신 reserve→confirm 직호출.
# real: 두 값 모두 '0' + 토스 테스트/라이브 키.
NEXT_PUBLIC_PAYMENTS_FAKE=1
TOSS_FAKE=1

# ===== 문자 알림 (솔라피) =====
# 세 값이 모두 채워지면 실제 SMS 발송, 하나라도 비면 noop(이력만 기록).
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
# 관리자 알림 수신 번호(쉼표 구분, 선택).
ADMIN_NOTIFY_PHONES=
# '1'이면 실제 발송 안 함(noop). 이력은 기록.
NOTIFICATIONS_DISABLED=0

# ===== 공휴일 (공공데이터포털 한국천문연구원 특일 정보) =====
# 서버 전용. 관리자 '공휴일 불러오기'에서 사용.
HOLIDAY_API_KEY=
